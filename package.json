{
  "name": "@devmaksi/pi-env",
  "version": "0.2.1",
  "description": "Profiles for the Pi coding agent: create, edit and launch isolated agent environments (settings, extensions, skills, MCP) from a terminal TUI",
  "type": "module",
  "bin": {
    "pi-env": "dist/index.js"
  },
  "files": [
    "dist",
    "pi"
  ],
  "pi": {
    "skills": [
      "./pi/skills"
    ],
    "image": "https://github.com/devmaksi/pi-env/raw/refs/heads/master/docs/screenshot.png"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devmaksi/pi-env.git"
  },
  "homepage": "https://github.com/devmaksi/pi-env#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-env",
    "pi-coding-agent",
    "coding-agent",
    "agent",
    "agent-harness",
    "environments",
    "profiles",
    "cli",
    "tui",
    "terminal",
    "developer-tools"
  ],
  "scripts": {
    "build": "tsc && rm -rf dist/locales && cp -r src/locales dist/locales",
    "test": "tsx --test test/*.test.ts",
    "bench": "tsx bench/paint-bench.ts",
    "demo": "python3 -m demo.capture --langs en,ru",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.8.0",
    "typescript": "^5.5.0"
  }
}
