  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devmaksi/pi-env.git"
  },
  "homepage": "https://github.com/devmaksi/pi-env#readme",
  "keywords": [
    "pi",
