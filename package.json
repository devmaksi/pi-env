{
  "name": "pi-env",
  "version": "0.1.0",
  "description": "CLI для управления окружениями pi",
  "type": "module",
  "bin": {
    "pi-env": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && rm -rf dist/locales && cp -r src/locales dist/locales",
    "test": "tsx --test test/*.test.ts",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.8.0",
    "typescript": "^5.5.0"
  }
}
